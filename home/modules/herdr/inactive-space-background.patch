+#[cfg(test)]
+mod inactive_space_tests {
+    use crate::{app::state::Palette, config::Config};
+    use ratatui::style::Color;
+
+    #[test]
+    fn inactive_space_background_is_optional_and_supports_mode_overrides() {
+        assert_eq!(Palette::dracula().inactive_space_bg, None);
+        let config: Config = toml::from_str(
+            r##"
+[theme.custom]
+inactive_space_bg = "#100D1C"
+[theme.custom.light]
+inactive_space_bg = "#EFE9DF"
+[theme.custom.dark]
+inactive_space_bg = "#171122"
+"##,
+        )
+        .unwrap();
+        let custom = config.theme.custom.unwrap();
+        let palette = Palette::dracula().with_overrides(&custom);
+        assert_eq!(palette.inactive_space_bg, Some(Color::Rgb(16, 13, 28)));
+        assert_eq!(
+            palette
+                .clone()
+                .with_mode_overrides(custom.light.as_ref().unwrap())
+                .inactive_space_bg,
+            Some(Color::Rgb(239, 233, 223))
+        );
+        assert_eq!(
+            palette
+                .with_mode_overrides(custom.dark.as_ref().unwrap())
+                .inactive_space_bg,
+            Some(Color::Rgb(23, 17, 34))
+        );
+    }
+}
