+#[test]
+fn inactive_space_background_fills_boxes_and_preserves_gaps_and_highlights() {
+    use ratatui::style::Color;
+
+    let sidebar = Color::Rgb(33, 29, 56);
+    let inactive = Color::Rgb(16, 13, 28);
+    let active = Color::Rgb(69, 61, 97);
+    let selected = Color::Rgb(51, 72, 56);
+    for compact in [false, true] {
+        for custom_background in [false, true] {
+            let parsed: Config = toml::from_str(
+                r##"
+[theme.custom]
+sidebar_bg = "#211D38"
+inactive_space_bg = "#100D1C"
+active_row_bg = "#453D61"
+selection_bg = "#334838"
+[ui.sidebar.spaces]
+row_gap = 1
+"##,
+            )
+            .unwrap();
+            let mut config = ClientShellConfig::from_config(&parsed);
+            if !custom_background {
+                config.palette.inactive_space_bg = None;
+            }
+            let inactive = if custom_background { inactive } else { sidebar };
+            let mut state = ClientShellState::new(config);
+            state.set_snapshot(Box::new(workspaces(3)));
+            state.set_pane_surface(surface());
+            state.sidebar_collapsed = compact;
+            let buffer = state.compose(100, 36).unwrap().to_ratatui_buffer().unwrap();
+            let check_box = |buffer: &Buffer, rect: Rect, color: Color| {
+                for y in rect.y..rect.bottom() {
+                    for x in rect.x..rect.right() {
+                        assert_eq!(buffer[(x, y)].bg, color, "box cell ({x}, {y})");
+                    }
+                }
+            };
+            for (id, color) in [("ws_1", active), ("ws_2", inactive), ("ws_3", inactive)] {
+                check_box(
+                    &buffer,
+                    workspace_rect(&state, &ClientEndpointId::Local, id),
+                    color,
+                );
+            }
+            if !compact {
+                let first = workspace_rect(&state, &ClientEndpointId::Local, "ws_1");
+                let second = workspace_rect(&state, &ClientEndpointId::Local, "ws_2");
+                assert_eq!(second.y, first.bottom() + 1);
+                check_box(
+                    &buffer,
+                    Rect::new(first.x, first.bottom(), first.width, 1),
+                    sidebar,
+                );
+            }
+            enter_navigation(&mut state);
+            preview_key(&mut state, b"\x1b[B");
+            let buffer = state.compose(100, 36).unwrap().to_ratatui_buffer().unwrap();
+            for (id, color) in [("ws_1", active), ("ws_2", selected), ("ws_3", inactive)] {
+                check_box(
+                    &buffer,
+                    workspace_rect(&state, &ClientEndpointId::Local, id),
+                    color,
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn inactive_space_background_applies_in_multi_endpoint_sidebars() {
+    use ratatui::style::Color;
+
+    let inactive = Color::Rgb(16, 13, 28);
+    for compact in [false, true] {
+        let (mut state, remote) = navigation_state(workspaces(3));
+        state.config.palette.inactive_space_bg = Some(inactive);
+        state.sidebar_collapsed = compact;
+        let buffer = state.compose(100, 44).unwrap().to_ratatui_buffer().unwrap();
+        for endpoint in [&ClientEndpointId::Local, &remote] {
+            let rect = workspace_rect(&state, endpoint, "ws_2");
+            // Expanded endpoint lists indent their workspace boxes by two columns.
+            let left = rect.x + if compact { 0 } else { 2 };
+            for y in rect.y..rect.bottom() {
+                for x in left..rect.right() {
+                    assert_eq!(buffer[(x, y)].bg, inactive, "endpoint box cell ({x}, {y})");
+                }
+            }
+        }
+    }
+}
